# ==============================================================================
# Real-Time Simultaneous Language Translator — Environment Configuration
# ==============================================================================

# --- Mode A: Fast & Free Default (Zero Paid API Keys Required) ---
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# Streaming & Clause Locking Tuning
SILENCE_THRESHOLD_MS=800
SLIDING_WINDOW_STEP_MS=400
TRANSLATION_DEBOUNCE_MS=150
MAX_CLAUSE_WORDS=15
VAD_RMS_THRESHOLD=0.008
VAD_SPEECH_PROB_THRESHOLD=0.45

# Cache Sizes
TRANSLATION_CACHE_SIZE=4096
TTS_CACHE_SIZE=128

# --- Mode B: Optional Ultra-Low-Latency Cloud API Upgrades ---
# Leave blank to run 100% free via Faster-Whisper / Hybrid ASR + Deep-Translator + Edge-TTS
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2/translate
GOOGLE_TRANSLATE_API_KEY=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
